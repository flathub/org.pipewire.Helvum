{
    "app-id": "org.pipewire.Helvum",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "command": "helvum",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc",
        "--filesystem=xdg-run/pipewire-0"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib"
    },
    "modules": [
        {
            "name": "Helvum",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.freedesktop.org/-/project/8123/uploads/720b9e2789c0cc37aae18bd91c9fa153/helvum-0.6.2.tar.xz",
                    "sha256": "288a9c94ddc507b1f85e576c3042ed795584cc09b05894e6bc7fdaaed9ff10ee"
                }
            ]
        }
    ]
}
